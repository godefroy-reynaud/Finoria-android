<?xml version="1.0" encoding="utf-8"?><!--
   Règles de sauvegarde/transfert (API 31+) — miroir de backup_rules.xml :
   - cloud-backup : sauvegarde Google (restauration après réinstallation) ;
   - device-transfer : copie directe lors d'un changement de téléphone.

   Base Room + DataStore inclus ensemble pour rester cohérents à la restauration.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
