<?xml version="1.0" encoding="utf-8"?><!--
   Règles Auto Backup (API < 31 — les API 31+ utilisent data_extraction_rules.xml).

   Tout l'état utilisateur est local : la base Room (comptes, transactions,
   récurrences, raccourcis, catégories) et le DataStore (compte sélectionné,
   flag de migration JSON→Room). Les deux doivent être sauvegardés ENSEMBLE
   pour rester cohérents à la restauration.
-->
<full-backup-content>
    <!-- Base Room (finoria.db + fichiers -wal/-shm) -->
    <include domain="database" path="." />
    <!-- DataStore Preferences (files/datastore/finoria_prefs.preferences_pb) -->
    <include domain="file" path="datastore/" />
</full-backup-content>
