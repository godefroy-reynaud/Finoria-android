<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fond clair dès le lancement, aligné sur le thème Compose
         (variante sombre dans values-night/themes.xml). -->
    <style name="Theme.Finoria" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/window_background_light</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Thème du splash screen système (API SplashScreen, rétro-compatible via
         androidx.core:core-splashscreen). Fond plat mode-aware + icône ronde bleue.
         NB : windowSplashScreenIconBackgroundColor est ignoré par plusieurs surcouches
         (constaté sur l'émulateur), donc le cercle bleu #022467 est directement intégré
         au drawable splash_logo (cercle bleu + F blanc), rendu tel quel par le système.
         Bascule vers Theme.Finoria une fois l'app prête. -->
    <style name="Theme.Finoria.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Finoria</item>
    </style>
</resources>